<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:text="12:00 PM"/>
    <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#9AA5BD" android:textSize="12sp" android:text="Monday, 12 October"/>
    <TextView android:id="@+id/verse" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp" android:maxLines="5" android:ellipsize="end"
        android:fontFamily="serif" android:textStyle="italic" android:textColor="#E8ECF5" android:textSize="14sp"/>
    <TextView android:id="@+id/ref" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#F2C14E" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
